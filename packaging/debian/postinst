#!/bin/sh
set -e

GROUP=linuwu_sense
if ! getent group "$GROUP" >/dev/null 2>&1; then
    addgroup --system "$GROUP"
fi
GROUP_GID=$(getent group "$GROUP" | cut -d: -f3)
printf 'LINUWU_GROUP_GID=%s\n' "$GROUP_GID" > /etc/default/linuwu-profile-helper
chmod 0644 /etc/default/linuwu-profile-helper

# When installed with sudo, grant the invoking desktop user access to the
# module's sysfs group. If no invoking user is available, the README explains
# how to add the account manually.
if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ] && id "$SUDO_USER" >/dev/null 2>&1; then
    adduser "$SUDO_USER" "$GROUP" || true
fi

if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    if [ -e /sys/devices/platform/acer-wmi/platform-profile/platform-profile-0/profile ]; then
        systemctl enable --now linuwu-profile-helper.service || true
    fi
fi

exit 0
